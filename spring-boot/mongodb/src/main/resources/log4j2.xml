<Configuration status="ERROR" name="flume-mongodb" monitorInterval="120">
  <Properties>
    <Property name="logdir">/opt/flume-mongodb/logs/</Property>
    <Property name="filename">flume.log</Property>
  </Properties>

  <Appenders>
    <RollingFile name="File" fileName="${logdir}/${filename}" filePattern="${logdir}/flume-%i.log">
      <PatternLayout>
        <Pattern>%d{dd MMM yyyy HH:mm:ss,SSS} %-5p [%t] (%C.%M:%L) %x - %m%n</Pattern>
      </PatternLayout>
      <SizeBasedTriggeringPolicy size="100MB"/>
      <DefaultRolloverStrategy max="100" />
    </RollingFile>
  </Appenders>

  <Loggers>

    <Logger name="org.apache.flume.lifecycle" level="INFO"/>
    <Logger name="org.apache.flume.channel" level="WARN"/>
    <Logger name="org.jboss" level="WARN"/>
    <Logger name="org.mortbay" level="INFO"/>
    <Logger name="org.apache.avro.ipc.NettyTransceiver" level="WARN"/>
    <Logger name="org.apache.hadoop" level="INFO"/>
    <Logger name="org.apache.hadoop.hive" level="ERROR"/>
    <Logger name="org.apache.flume" level="INFO"/>

    <Root level="INFO">
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>

</Configuration>
